<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Grand Salon — Appointments</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Public+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: #FAF6F1;
    font-family: 'Public Sans', sans-serif;
    color: #2B1F2E;
  }
  .display { font-family: 'Fraunces', serif; }
  .mono { font-family: 'JetBrains Mono', monospace; }

  .wrap { max-width: 760px; margin: 0 auto; padding: 32px 20px 60px; }
  @media (min-width: 640px) { .wrap { padding: 40px 32px 60px; } }

  .header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 32px; }
  .eyebrow { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #8C3D4F; margin: 0 0 4px; }
  .title { font-size: 30px; line-height: 1.15; margin: 0; }
  @media (min-width: 640px) { .title { font-size: 34px; } }
  .badge { height: 44px; width: 44px; border-radius: 999px; background: #2B1F2E; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 32px; }
  .stat-card { border: 1px solid rgba(43,31,46,0.1); background: rgba(255,255,255,0.7); border-radius: 16px; padding: 14px 16px; }
  .stat-label { display: flex; align-items: center; gap: 6px; color: rgba(43,31,46,0.45); margin-bottom: 4px; font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; }
  .stat-value { font-size: 24px; margin: 0; }

  .controls { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
  .toggle { display: flex; border-radius: 999px; border: 1px solid rgba(43,31,46,0.12); padding: 4px; background: rgba(255,255,255,0.6); width: fit-content; }
  .toggle button { border: none; background: none; padding: 6px 16px; border-radius: 999px; font-size: 14px; font-weight: 500; cursor: pointer; color: rgba(43,31,46,0.6); font-family: inherit; }
  .toggle button.active { background: #2B1F2E; color: #FAF6F1; }

  .day-nav { display: flex; align-items: center; gap: 8px; border-radius: 999px; border: 1px solid rgba(43,31,46,0.12); background: rgba(255,255,255,0.6); padding: 4px 8px; width: fit-content; }
  .day-nav button { border: none; background: none; cursor: pointer; padding: 4px; border-radius: 999px; display: flex; }
  .day-nav button:hover { background: rgba(43,31,46,0.05); }
  .day-nav span { font-size: 14px; padding: 0 4px; white-space: nowrap; }

  .search-box { flex: 1; min-width: 180px; position: relative; }
  .search-box svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); opacity: 0.4; }
  .search-box input { width: 100%; padding: 9px 14px 9px 34px; border-radius: 999px; border: 1px solid rgba(43,31,46,0.12); background: rgba(255,255,255,0.6); font-size: 14px; font-family: inherit; outline: none; }
  .search-box input:focus { box-shadow: 0 0 0 2px rgba(140,61,79,0.3); }

  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
  .filter-chip { font-size: 12px; padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(43,31,46,0.15); color: rgba(43,31,46,0.6); background: none; cursor: pointer; text-transform: capitalize; font-family: inherit; }
  .filter-chip.active { border-color: #2B1F2E; background: #2B1F2E; color: #FAF6F1; }

  .list { display: flex; flex-direction: column; gap: 8px; }
  .card { display: flex; align-items: stretch; gap: 16px; border-radius: 16px; border: 1px solid rgba(43,31,46,0.1); background: rgba(255,255,255,0.7); padding: 12px 16px 12px 0; }
  .card-time { width: 74px; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1px dashed rgba(43,31,46,0.15); padding: 4px 0; }
  .card-time .t1 { font-size: 13px; }
  .card-time .t2 { font-size: 10px; opacity: 0.4; }
  .card-body { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .card-name { font-size: 15px; font-weight: 500; margin: 0 0 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card-sub { font-size: 13px; opacity: 0.55; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .status-pill { display: flex; align-items: center; gap: 6px; font-size: 11px; padding: 4px 10px; border-radius: 999px; }
  .status-dot { height: 6px; width: 6px; border-radius: 999px; }
  .cancel-btn { border: none; background: none; padding: 6px; border-radius: 999px; cursor: pointer; color: #8C3D4F; }
  .cancel-btn:hover { background: #F5EBEC; }

  .empty { text-align: center; padding: 60px 20px; border: 1px dashed rgba(43,31,46,0.15); border-radius: 16px; }
  .empty p:first-child { font-size: 18px; opacity: 0.7; margin: 0 0 4px; }
  .empty p:last-child { font-size: 14px; opacity: 0.45; margin: 0; }

  .footer-note { text-align: center; font-size: 10px; opacity: 0.3; margin-top: 32px; letter-spacing: 0.03em; }

  .overlay { position: fixed; inset: 0; background: rgba(43,31,46,0.4); display: flex; align-items: center; justify-content: center; padding: 20px; z-index: 50; }
  .modal { background: #FAF6F1; border-radius: 16px; padding: 24px; max-width: 340px; width: 100%; border: 1px solid rgba(43,31,46,0.1); }
  .modal-title { display: flex; align-items: center; gap: 8px; color: #8C3D4F; margin-bottom: 12px; font-size: 14px; font-weight: 500; }
  .modal-body { font-size: 14px; opacity: 0.6; margin-bottom: 20px; }
  .modal-actions { display: flex; gap: 8px; justify-content: flex-end; }
  .modal-actions button { border-radius: 999px; padding: 8px 16px; font-size: 14px; cursor: pointer; font-family: inherit; }
  .btn-keep { border: 1px solid rgba(43,31,46,0.15); background: none; color: rgba(43,31,46,0.7); }
  .btn-cancel { border: none; background: #8C3D4F; color: white; }

  .loading { text-align: center; padding: 60px 20px; opacity: 0.4; font-size: 14px; }
  .error-box { text-align: center; padding: 40px 20px; border: 1px solid rgba(140,61,79,0.3); background: #F5EBEC; border-radius: 16px; color: #8C3D4F; font-size: 14px; }
</style>
</head>
<body>

<div class="wrap">
  <div class="header">
    <div>
      <p class="eyebrow mono">Appointment Book</p>
      <h1 class="title display">Grand Salon</h1>
    </div>
    <div class="badge">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FAF6F1" stroke-width="2"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
    </div>
  </div>

  <div id="stats" class="stats"></div>

  <div class="controls">
    <div class="toggle" id="view-toggle">
      <button data-view="day" class="active">Day view</button>
      <button data-view="upcoming">Upcoming</button>
    </div>
    <div class="day-nav" id="day-nav">
      <button id="prev-day"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2B1F2E" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg></button>
      <span id="day-label"></span>
      <button id="next-day"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2B1F2E" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></button>
    </div>
    <div class="search-box">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2B1F2E" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="search" placeholder="Search name, service, ticket ID" />
    </div>
  </div>

  <div class="filters" id="filters"></div>

  <div id="list-area"><div class="loading">Loading appointments…</div></div>

  <p class="footer-note mono">Synced live from Supabase</p>
</div>

<div id="modal-root"></div>

<script>
// ---------------------------------------------------------------------------
// SUPABASE CONNECTION
// ---------------------------------------------------------------------------
const SUPABASE_URL = "https://biznmfsodqltwxswhwjx.supabase.co";
const SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJpem5tZnNvZHFsdHd4c3dod2p4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM1MDIxMzEsImV4cCI6MjA5OTA3ODEzMX0.c-XRXCQeIRbgtrOLPLitm4pAvF3SBAByG0qw2KkDets";
const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

const TABLE = "Appointments";

const STATUS_STYLES = {
  scheduled: { label: "Scheduled", dot: "#6B8F71", text: "#4A6B4F", bg: "#EDF3EC" },
  confirmed: { label: "Confirmed", dot: "#6B8F71", text: "#4A6B4F", bg: "#EDF3EC" },
  rescheduled: { label: "Rescheduled", dot: "#B08D57", text: "#8A6B3F", bg: "#F6EFE2" },
  cancelled: { label: "Cancelled", dot: "#A9838C", text: "#8C5D66", bg: "#F5EBEC" },
};
function styleFor(status) {
  const key = (status || "").toLowerCase().trim();
  return STATUS_STYLES[key] || { label: status || "Unknown", dot: "#A9838C", text: "#8C5D66", bg: "#F5EBEC" };
}

let appointments = [];
let dayOffset = 0;
let view = "day";
let statusFilter = "all";
let query = "";

function parseDateTime(row) {
  // date: "2026-07-22", Time: "10:00"
  const d = row["date"] || "";
  const t = row["Time"] || "00:00";
  const dt = new Date(`${d}T${t.length === 5 ? t : t.padStart(5, "0")}:00`);
  return isNaN(dt.getTime()) ? null : dt;
}

function sameDay(a, b) {
  return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
}
function fmtTime(d) {
  return d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
}
function fmtDayLabel(d) {
  return d.toLocaleDateString("en-US", { weekday: "long", month: "short", day: "numeric" });
}

async function loadAppointments() {
  const listArea = document.getElementById("list-area");
  const { data, error } = await client.from(TABLE).select("*");
  if (error) {
    listArea.innerHTML = `<div class="error-box">Couldn't load appointments: ${error.message}</div>`;
    return;
  }
  appointments = (data || []).map((row) => ({
    raw: row,
    ticketId: row["Ticket-id"],
    name: row["Name"],
    number: row["Number"],
    service: row["Service"],
    status: row["status"],
    dt: parseDateTime(row),
  })).filter((a) => a.dt);
  render();
}

async function cancelAppointment(ticketId) {
  const { error } = await client.from(TABLE).update({ status: "Cancelled" }).eq("Ticket-id", ticketId);
  if (!error) {
    const a = appointments.find((x) => x.ticketId === ticketId);
    if (a) a.status = "Cancelled";
  }
  closeModal();
  render();
}

function computeStats() {
  const today = new Date();
  const todays = appointments.filter((a) => sameDay(a.dt, today) && styleFor(a.status).label !== "Cancelled");
  const weekAhead = new Date(today.getTime() + 7 * 86400000);
  const week = appointments.filter((a) => a.dt >= today && a.dt <= weekAhead);
  const cancelled = appointments.filter((a) => styleFor(a.status).label === "Cancelled").length;
  const rate = appointments.length ? Math.round((cancelled / appointments.length) * 100) : 0;
  return { todayCount: todays.length, weekCount: week.length, cancelRate: rate };
}

function currentViewDate() {
  const d = new Date();
  d.setDate(d.getDate() + dayOffset);
  return d;
}

function filteredList() {
  const today = new Date();
  let list = appointments;
  if (view === "day") {
    const vd = currentViewDate();
    list = list.filter((a) => sameDay(a.dt, vd));
  } else {
    list = list.filter((a) => a.dt >= today);
  }
  if (statusFilter !== "all") {
    list = list.filter((a) => styleFor(a.status).label.toLowerCase() === statusFilter);
  }
  if (query.trim()) {
    const q = query.toLowerCase();
    list = list.filter((a) =>
      (a.name || "").toLowerCase().includes(q) ||
      (a.ticketId || "").toLowerCase().includes(q) ||
      (a.service || "").toLowerCase().includes(q)
    );
  }
  return [...list].sort((a, b) => a.dt - b.dt);
}

function render() {
  const stats = computeStats();
  document.getElementById("stats").innerHTML = `
    <div class="stat-card"><div class="stat-label">Today</div><p class="stat-value display">${stats.todayCount}</p></div>
    <div class="stat-card"><div class="stat-label">Next 7 days</div><p class="stat-value display">${stats.weekCount}</p></div>
    <div class="stat-card"><div class="stat-label">Cancel rate</div><p class="stat-value display">${stats.cancelRate}%</p></div>
  `;

  document.getElementById("day-nav").style.display = view === "day" ? "flex" : "none";
  document.getElementById("day-label").textContent = fmtDayLabel(currentViewDate());

  const statuses = ["all", "scheduled", "rescheduled", "cancelled"];
  document.getElementById("filters").innerHTML = statuses.map((s) =>
    `<button class="filter-chip ${statusFilter === s ? "active" : ""}" data-status="${s}">${s}</button>`
  ).join("");

  const list = filteredList();
  const listArea = document.getElementById("list-area");
  if (list.length === 0) {
    listArea.innerHTML = `<div class="empty"><p class="display">Nothing here yet</p><p>New bookings from WhatsApp will appear automatically.</p></div>`;
  } else {
    listArea.innerHTML = `<div class="list">${list.map(cardHtml).join("")}</div>`;
  }

  // rebind events
  document.querySelectorAll(".cancel-btn").forEach((btn) => {
    btn.addEventListener("click", () => openModal(btn.dataset.ticket, btn.dataset.name));
  });
  document.querySelectorAll(".filter-chip").forEach((btn) => {
    btn.addEventListener("click", () => { statusFilter = btn.dataset.status; render(); });
  });
}

function cardHtml(a) {
  const s = styleFor(a.status);
  const isCancelled = s.label === "Cancelled";
  return `
    <div class="card">
      <div class="card-time">
        <span class="t1 mono">${fmtTime(a.dt)}</span>
      </div>
      <div class="card-body">
        <div style="min-width:0;">
          <p class="card-name">${a.name || "—"}</p>
          <p class="card-sub">${a.service || "—"} · <span class="mono">${a.ticketId || ""}</span></p>
        </div>
        <div class="card-right">
          <span class="status-pill" style="background:${s.bg}; color:${s.text};">
            <span class="status-dot" style="background:${s.dot};"></span>${s.label}
          </span>
          ${!isCancelled ? `<button class="cancel-btn" data-ticket="${a.ticketId}" data-name="${a.name || ""}" title="Cancel appointment">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>` : ""}
        </div>
      </div>
    </div>
  `;
}

function openModal(ticketId, name) {
  document.getElementById("modal-root").innerHTML = `
    <div class="overlay">
      <div class="modal">
        <div class="modal-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8C3D4F" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          Cancel this appointment?
        </div>
        <div class="modal-body">${name}'s slot will be freed. This can't be undone from here.</div>
        <div class="modal-actions">
          <button class="btn-keep" id="modal-keep">Keep it</button>
          <button class="btn-cancel" id="modal-cancel">Cancel appointment</button>
        </div>
      </div>
    </div>
  `;
  document.getElementById("modal-keep").addEventListener("click", closeModal);
  document.getElementById("modal-cancel").addEventListener("click", () => cancelAppointment(ticketId));
}
function closeModal() {
  document.getElementById("modal-root").innerHTML = "";
}

document.getElementById("view-toggle").addEventListener("click", (e) => {
  const btn = e.target.closest("button");
  if (!btn) return;
  view = btn.dataset.view;
  document.querySelectorAll("#view-toggle button").forEach((b) => b.classList.toggle("active", b === btn));
  render();
});
document.getElementById("prev-day").addEventListener("click", () => { dayOffset -= 1; render(); });
document.getElementById("next-day").addEventListener("click", () => { dayOffset += 1; render(); });
document.getElementById("search").addEventListener("input", (e) => { query = e.target.value; render(); });

loadAppointments();
</script>
</body>
</html>
